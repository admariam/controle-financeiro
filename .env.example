# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Nunca use a chave service_role no frontend.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
VITE_SHARED_EMAIL=acesso@exemplo.com

# Opcional: caminho base do GitHub Pages (ex.: /controle-financeiro/).
# Em desenvolvimento deixe vazio ou use "/".
VITE_BASE_PATH=/
